# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — never expose to the client
SUPABASE_SERVICE_ROLE_KEY=

# Drizzle / direct Postgres connection (Project Settings → Database → Connection string → URI)
# Use the pooled URI for runtime (ends with :6543/postgres) and the direct URI for drizzle-kit migrations.
DATABASE_URL=postgresql://postgres:PASSWORD@HOST:6543/postgres?pgbouncer=true

# AI provider — balanced 티어 기본 provider. 미설정 시 "upstage"(= Solar Pro 3, 한국어·저비용).
# "anthropic"으로 두면 즉시 Claude 롤백. reasoning 티어는 항상 Anthropic.
AI_PROVIDER=upstage

# Upstage Solar — server-only. OpenAI 호환(base URL https://api.upstage.ai/v1, 모델 solar-pro3).
# 발급: https://console.upstage.ai → API Keys. (AI_PROVIDER=upstage면 이 키가 기본 사용됨)
# UPSTAGE_API_KEY: 기본 키 (등록상담/회의록 분석)
UPSTAGE_API_KEY=
# UPSTAGE_API_KEY_CONSULTATIONS: 학생 케어 인사이트 전용 (없으면 UPSTAGE_API_KEY로 폴백)
UPSTAGE_API_KEY_CONSULTATIONS=

# Anthropic — server-only. AI_PROVIDER=anthropic이거나 Upstage 키가 없을 때 폴백, reasoning 티어 전용.
# ANTHROPIC_API_KEY: 기본 키 (등록상담/회의록 분석)
ANTHROPIC_API_KEY=
# ANTHROPIC_API_KEY_CONSULTATIONS: 학생 케어 인사이트 전용 (사용량 분리)
ANTHROPIC_API_KEY_CONSULTATIONS=

# AssemblyAI — 한국어 음성 전사 (회의록 + 등록상담)
ASSEMBLYAI_API_KEY=
# Webhook callback secret — POST /api/webhooks/assemblyai에서 x-eywa-webhook-secret 헤더로 검증
ASSEMBLYAI_WEBHOOK_SECRET=

# 앱 공개 URL — AssemblyAI 전사 콜백 URL 파생에 필수(getAppUrl). 미설정 시 녹음 분석이 명확히 실패한다
# (옛 'eywa-alpha.vercel.app' 조용한 폴백 제거됨). 프로덕션은 실제 도메인, 로컬은 콜백이 도달할 공개 호스트로.
# 로컬에서 녹음 분석을 시험하려면 프로덕션 웹훅 호스트를 명시: https://eywa-alpha.vercel.app
NEXT_PUBLIC_APP_URL=https://eywa-alpha.vercel.app

# 멈춘 전사 복구 cron 인증 — GET /api/cron/reconcile-transcriptions의 Authorization: Bearer <CRON_SECRET>.
# Vercel cron이 자동 주입(Project Settings → Cron). 미설정 시 라우트는 401(보호).
CRON_SECRET=

# Gemini (선택) — fast-tier 작업용. 현재 코드에서는 미사용
GEMINI_API_KEY=

# Google Sheets 동기화 (선택) — service account JWT
# Google Cloud Console에서 service account 생성 후 JSON 키 다운로드 → 전체 JSON 또는 base64 인코딩 후 입력
# scopes: drive, spreadsheets
GOOGLE_SERVICE_ACCOUNT_KEY=

# 미디어 스토리지(녹음·이미지) — ijw Firebase Storage에 새 업로드를 저장하고 레거시 녹음도 읽는다.
# ⚠️ MEDIA_STORAGE_BACKEND=gcs(기본)면 신규 업로드가 Firebase로 가므로 이 키가 **필수**(미설정 시 전 업로드 실패).
# ijw Firebase serviceAccount.json(전체 JSON 또는 base64). FIREBASE_STORAGE_BUCKET 미설정 시 ijw-calander.firebasestorage.app.
FIREBASE_SERVICE_ACCOUNT_KEY=
# FIREBASE_STORAGE_BUCKET=ijw-calander.firebasestorage.app

# 신규 미디어 업로드 백엔드 — "gcs"(기본, ijw Firebase) | "supabase"(결제 구간 스왑).
# ⚠️ supabase로 바꾸기 전 기존 GCS tenant 객체를 Supabase로 이전할 것(전역 플래그라 객체별 분기 아님).
# 브라우저→GCS 직접 PUT엔 버킷 CORS 필요: `node scripts/setup-gcs-cors.cjs` 1회 실행.
MEDIA_STORAGE_BACKEND=gcs

# ── 출석 키오스크 알림톡 (Solapi 실발송) ───────────────────────────────────────
# 키가 없거나 라이선스(tenant_licenses 'kakao_messaging')·학원 채널(kakao_channels)이 미설정이면
# 현행 '발송 시뮬레이션'(실제 전송 없음)으로 동작한다 — 아래 키만으로는 실발송이 켜지지 않는다.
# operator(EYWA) 단일 계정의 전역 키. 학원별 식별은 DB(kakao_channels)의 pfId·승인 템플릿 ID로.
# 발급: https://console.solapi.com → API Key 관리.
# SOLAPI_API_KEY=
# SOLAPI_API_SECRET=
# SMS 대체발송(disableSms=false) 시 발신번호로 쓰일 사전 등록 발신번호.
# SOLAPI_FROM=
# 발송 결과 콜백 검증용 시크릿 — POST /api/webhooks/solapi 에서 사용(Phase 3)
# KAKAO_WEBHOOK_SECRET=
