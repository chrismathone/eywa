# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — never expose to the client
SUPABASE_SERVICE_ROLE_KEY=

# Drizzle / direct Postgres connection (Project Settings → Database → Connection string → URI)
# Use the pooled URI for runtime (ends with :6543/postgres) and the direct URI for drizzle-kit migrations.
DATABASE_URL=postgresql://postgres:PASSWORD@HOST:6543/postgres?pgbouncer=true

# AI 회사는 Claude(1순위) · ChatGPT(OpenAI 폴백) 둘이다. reasoning·문서·이미지·승인 기능은 Claude 전용.
# OPENAI_API_KEY가 없으면 후보에서 빠지고 Claude만 종전대로 돈다.

# ── AI 키는 **기능별 12그룹**으로 나뉜다 (원장 2026-09-15) ─────────────────────
# 이름 규칙 = `<회사>_API_KEY_<그룹>`. 그룹은 호출부 이름(meta.feature)에서 FEATURE_KEY_GROUP이 도출한다
# (src/lib/ai/models.ts). 해석 순서 = **그룹 키 → 옛 버킷(CONSULTATIONS) → 기본 키**.
# 🔴 **기본 키(접미사 없는 2개)는 절대 지우지 말 것** — 그룹 키가 없는 기능·새 호출부의 유일한 안전망이다.
#    지우면 그 기능이 조용히 다른 회사(폴백)로 넘어가 모델과 품질이 바뀐다.
# 그룹: MENT(멘트·영어 코멘트·말투) · MEETING(회의록) · ENROLLMENT(콜&상담) · CONSULTATIONS(원생상담·케어)
#          · BRIEFING(운영실) · ATTENDANCE(출결) · NOTICE(공지 번역) · STAFF(계약서)
#          · VIDEO(영상 참고) · STUDENT_ONTOLOGY(원생 기록) · ASSISTANT(학원 비서) · MANAGEMENT(경영 분석)
# 그룹 키를 비워 두면 기본 키로 넘어가고, 사용량 표(ai_usage_logs.key_name)에 'default'로 찍혀 드러난다.
# ⚠️ 아래에 회사×그룹 조합을 다 적어 두지는 않았다 — **지금 그 회사가 1순위인 그룹만** 적었다(Anthropic의
#    MEETING·ATTENDANCE·NOTICE는 폴백 전용이라 평소 호출이 0). 필요하면
#    같은 규칙(`<회사>_API_KEY_<그룹>`)으로 더 만들면 코드가 그대로 알아본다 — 목록을 고칠 필요 없다.

# Anthropic — server-only, 항상 1순위. 발급: https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_API_KEY_MENT=
ANTHROPIC_API_KEY_BRIEFING=
ANTHROPIC_API_KEY_STAFF=
ANTHROPIC_API_KEY_ENROLLMENT=
# CONSULTATIONS는 옛 '학생 케어 전용' 키와 **이름이 같다** — 뜻만 'consultations 그룹'으로 넓어졌다.
ANTHROPIC_API_KEY_CONSULTATIONS=
# VIDEO = 영상 설명 AI 참고 메모(0390a · 밤 배치 판정·확인) — Max 크레딧이 들어오는 콘솔 조직의 키를 두면 지출이 그 크레딧에서 빠진다(2026-10-21).
ANTHROPIC_API_KEY_VIDEO=

# OpenAI — server-only, Claude 인증·한도·잔액 문제 때의 ChatGPT 폴백. 발급: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_API_KEY_MENT=
OPENAI_API_KEY_MEETING=
OPENAI_API_KEY_ENROLLMENT=
OPENAI_API_KEY_CONSULTATIONS=
OPENAI_API_KEY_ATTENDANCE=
OPENAI_API_KEY_NOTICE=

# AssemblyAI — 한국어 음성 전사 (회의록 + 등록상담)
ASSEMBLYAI_API_KEY=
# Webhook callback secret — POST /api/webhooks/assemblyai에서 x-eywa-webhook-secret 헤더로 검증
ASSEMBLYAI_WEBHOOK_SECRET=

# 앱 공개 URL — AssemblyAI 전사 콜백 URL 파생에 필수(getAppUrl). 미설정 시 녹음 분석이 명확히 실패한다
# (옛 'eywa-alpha.vercel.app' 조용한 폴백 제거됨). 프로덕션은 실제 도메인, 로컬은 콜백이 도달할 공개 호스트로.
# 로컬에서 녹음 분석을 시험하려면 프로덕션 웹훅 호스트를 명시: https://www.aywa.co.kr (2026-09-21~, 옛 eywa-alpha는 전환됨)
NEXT_PUBLIC_APP_URL=https://www.aywa.co.kr

# 도메인 이전용(2026-09-18 준비 · 구매 뒤에만 채운다 — docs/domain-cutover.md): 옛 호스트로 온 **페이지** 요청을
# NEXT_PUBLIC_APP_URL의 같은 경로로 308(붙여 둔 자산 QR 라벨·공유 링크 보존). /api/* 는 제외. 쉼표로 여러 개.
# 비어 있으면 리다이렉트 0개. 🔴 Vercel env는 배포 시점 스냅샷 — 넣은 뒤 **재배포**해야 켜진다.
LEGACY_REDIRECT_HOSTS=

# 멈춘 전사 복구 cron 인증 — GET /api/cron/reconcile-transcriptions의 Authorization: Bearer <CRON_SECRET>.
# Vercel cron이 자동 주입(Project Settings → Cron). 미설정 시 라우트는 401(보호).
CRON_SECRET=

# (2026-07-29 소등) Edutrix 원본 DB **앱 연동은 제거**됨 — 이관 크론·미매핑 탭 삭제, EDUTRIX_TENANT_ID 소비처 0.
# 아래 2종은 은퇴 스크립트(scripts/_edutrix_retire/archive-edutrix.cjs·full-import-reports.cjs) 전용이며
# **원본 프로젝트가 살아 있을 때만** 의미가 있다(현재 일시정지). 원본 삭제 후엔 이 두 줄도 지울 것.
EDUTRIX_SUPABASE_URL=
EDUTRIX_SUPABASE_ANON_KEY=

# (Gemini는 2026-09-15에 지웠다 — 코드 소비처가 0곳이고 SDK도 안 깔려 있었다. 쓰게 되면 그때 다시 넣을 것.)

# Google Sheets 동기화 (선택) — service account JWT
# Google Cloud Console에서 service account 생성 후 JSON 키 다운로드 → 전체 JSON 또는 base64 인코딩 후 입력
# scopes: drive, spreadsheets
GOOGLE_SERVICE_ACCOUNT_KEY=

# 상담 텍스트 외부 AI 반출 API (선택) — GET /api/exports/consultations (Bearer 토큰 인증).
# 원장의 외부 챗봇("AI 사무실")이 마스킹된 상담 텍스트를 읽는 용도. 미설정 시 503(기능 꺼짐).
# 긴 무작위 문자열 권장(예: openssl rand -hex 32). 소비 측에서 Authorization: Bearer <값>으로 호출.
CONSULT_EXPORT_TOKEN=
# 테넌트 2개 이상일 때만 필수 — 반출 대상 tenant id 명시(1개면 자동 확정).
# CONSULT_EXPORT_TENANT_ID=

# 직원 이력서 → "신규 직원명부" 구글시트 기입 (선택) — 이력서 신규 저장 시 한 행 append.
# 값 = "2020~2026 직원명부" 스프레드시트 URL의 /d/와 /edit 사이 ID.
# 미설정 시 기입만 조용히 꺼진다(저장은 정상, 서버 로그에만 남음) — 실운영은 Vercel env에 반드시 설정.
# 시트는 위 서비스계정(GOOGLE_/FIREBASE_SERVICE_ACCOUNT_KEY) 이메일에 '편집자'로 공유돼 있어야 한다.
HR_ROSTER_SPREADSHEET_ID=
# 기입 대상 탭 이름 — 미설정 시 "2026신규 직원명부". 연도가 바뀌면 이 값만 갱신.
# HR_ROSTER_SHEET_TAB=2026신규 직원명부
# 이 명부 시트가 어느 지점 것인가 — 비우면 학원이 정확히 1개일 때만 기입(둘 이상인데 비어 있으면 아무 지점도 기입 안 함).
# 둘째 지점을 만들기 전에 침산 id로 못박는다(docs/domain-cutover.md 0번).
HR_ROSTER_TENANT_ID=

# Notion 업무 연동 (선택) — 직원 상세 '월간일정' 탭이 Notion 업무 DB를 마감일 기준으로 읽어온다(읽기 전용).
# 토큰은 secret이라 env 전용(DB/tenant_settings 금지). DB id는 식별자라 여기 둠(단일 운영 DB 전제).
# 발급: https://www.notion.so/my-integrations → Internal Integration 생성 → "Read content"+"Read user information" 권한.
#       그 통합을 대상 업무 DB 페이지의 ⋯ → 연결(Connections)에 추가해야 API에 보인다.
# NOTION_TOKEN: Internal Integration Secret (ntn_… / secret_…). server-only, 절대 NEXT_PUBLIC_ 아님.
NOTION_TOKEN=
# NOTION_TASKS_DATABASE_ID: 업무 DB id(URL의 32자 hex). 담당자(정)·마감일·업무완료 속성 필요(속성명은 notion-tasks.ts).
NOTION_TASKS_DATABASE_ID=
# NOTION_TENANT_ID: 이 업무 DB가 속한 지점(tenants.id). 없거나 다른 지점이면 Notion 탭이 닫힌다(fail-closed —
#   지점이 둘 이상인데 한 학원의 업무 DB가 다른 지점 직원에게 열리지 않게, 2026-09-22). 침산 = becaa316-e636-42e9-9d09-08b133e0b094.
NOTION_TENANT_ID=

# 구글시트 전용 SA(eywa-injaewon GCP 프로젝트, 2026-07-28 신설) — 시트 연동(시간표 동기·직원명부)은
# 이 키가 우선. 전체 JSON 또는 base64. (과거엔 FIREBASE 키 폴백으로 돌았으나 ijw 소등 대비 분리.)
GOOGLE_SERVICE_ACCOUNT_KEY=

# 미디어 스토리지(녹음·이미지) = **Supabase Storage 전용**(2026-07-29). 앱에는 설정할 env가 없다 —
# 버킷은 kind별로 코드에 고정(media-storage.ts MEDIA_KIND)이고 자격증명은 SUPABASE_SERVICE_ROLE_KEY를 쓴다.
# ⚠️ 옛 `MEDIA_STORAGE_BACKEND` / `FIREBASE_STORAGE_BUCKET`은 **제거됐다**(ijw-calander GCP 삭제로 GCS는
#    되돌릴 수 없는 죽은 경로 — 되살릴 수 있는 척하는 플래그를 남기지 않으려고 지웠다). 다시 만들지 말 것.

# ⚠️ 앱은 더 이상 이 키를 쓰지 않는다(2026-07-29 GCS 제거). 남겨둔 이유는 **로컬 일회성 스크립트** 뿐
#    (scripts/_english_sync/*, scripts/staff-roster-import/* 이 GOOGLE_SERVICE_ACCOUNT_KEY 없을 때 폴백).
#    프로덕션 Vercel엔 설정하지 않는다(실제로 없었고, 시트 연동은 GOOGLE_SERVICE_ACCOUNT_KEY가 담당).
FIREBASE_SERVICE_ACCOUNT_KEY=

# ── 출석 키오스크 알림톡 (Solapi 실발송) ───────────────────────────────────────
# 키가 없거나 라이선스(tenant_licenses 'kakao_messaging')·학원 채널(kakao_channels)이 미설정이면
# 현행 '발송 시뮬레이션'(실제 전송 없음)으로 동작한다 — 아래 키만으로는 실발송이 켜지지 않는다.
# operator(AYWA) 단일 계정의 전역 키. 학원별 식별은 DB(kakao_channels)의 pfId·승인 템플릿 ID로.
# 발급: https://console.solapi.com → API Key 관리.
# SOLAPI_API_KEY=
# SOLAPI_API_SECRET=
# SMS 대체발송(disableSms=false) 시 발신번호로 쓰일 사전 등록 발신번호.
# SOLAPI_FROM=
# 발송 결과 콜백 검증용 시크릿 — POST /api/webhooks/solapi 에서 사용(Phase 3)
# KAKAO_WEBHOOK_SECRET=
# ── 카카오 지도 (셔틀 정류장 위치 · 학부모 실시간 차량) ────────────────────────────
# 둘 다 **선택**이다. 없으면 지도 대신 안내 문구가 뜨고 나머지 기능은 그대로 돈다.
# 발급: https://developers.kakao.com → 내 애플리케이션 → 앱 키. [플랫폼 > Web]에 사이트 도메인을 등록해야 지도가 뜬다
# (로컬은 http://localhost:3000 — 포트까지 정확히, 미등록이면 "domain mismatched"). 앱 설정에서 카카오맵 사용도 켤 것.
# JavaScript 키 — 브라우저에 그대로 노출되는 공개용 키(도메인으로 막힌다).
# NEXT_PUBLIC_KAKAO_MAP_KEY=
# REST API 키 — 서버 전용(장소·주소 검색). 🔴 NEXT_PUBLIC_를 붙이지 말 것.
# KAKAO_REST_API_KEY=

# ── 학교 데이터 (현황 지도 · 학교별 점유율) ──────────────────────────────────
# 셋 다 **선택**이다. 없으면 학교 관련 기능만 꺼지고 앱은 정상 동작한다(필수 검증에 넣지 말 것).
#
# 🔴 무엇이 어디서 나오는지 (2026-08-05 실호출로 확인):
#   · NEIS         → 학교코드(SD_SCHUL_CODE) · 학교명 · **도로명주소** · 설립구분. **전교생 수는 없다.**
#                    ⚠️ 동명 학교가 많다("칠성초" 검색에 대구·충북·전남 3곳) → 조회 시 **시도 필터 필수**,
#                       안 걸면 지도에 엉뚱한 지역 학교가 찍힌다.
#   · 학교알리미    → **학년별·학급별 학생수**(점유율의 분모). NEIS가 못 주는 바로 그 값.
#   · 공공데이터포털 → 표준데이터(위치 등). ⚠️ 키가 있어도 **데이터셋마다 활용신청**을 따로 해야 열린다
#                    (신청 전엔 `{"code":-3,"msg":"등록되지 않은 서비스 입니다."}`).
#
# ⚠️ 2026-09-15에 셋(SCHOOLINFO_API_KEY · NEIS_API_KEY · DATA_GO_KR_API_KEY)을 지웠다 —
#    앱에 소비처가 **각 0파일**이었다(학교 정보는 지금 DB에 들어 있는 값을 쓴다).
#    다시 쓰게 되면 그때 발급해 여기 넣을 것. 각각 발급처가 다르고 서로 대체되지 않는다:
#    학교알리미 https://www.schoolinfo.go.kr · NEIS https://open.neis.go.kr · 공공데이터포털 data.go.kr

# ── 인재원 학습 프로그램(MemoType) 읽기 API (선택, 2026-09-10) ──────────────────
# 성적관리 '영어 › JJ실 · JJ실(시험)'과 학생 상세 '성적' 탭이 인재원(D:\anki-main)에 **서버끼리** 묻는다(pull).
# 설명서: D:\anki-main\memotype\docs\EYWA-API.md. 셋 중 하나라도 비면 화면은 "연동이 아직 설정되지 않았습니다"만 보인다.
# IJW_API_URL: 인재원 주소(끝 / 없이, 예 https://injaewon.vercel.app)
# IJW_API_SECRET: 인재원 쪽 EYWA_API_SECRET과 **같은 값**. server-only, 절대 NEXT_PUBLIC_ 아님.
# IJW_TENANT_ID: 이 데이터가 속한 학원(tenant id) — 다른 학원 요청엔 부르지 않는다(인재원 데이터는 한 학원 것).
IJW_API_URL=
IJW_API_SECRET=
IJW_TENANT_ID=

# ── 비로그인 화면의 회사 브랜드 (선택, 2026-09-18 · 학원이 둘 이상일 때만 뜻이 있다) ─────────────
# 멀티테넌트 = 하나의 DB · URL에 지점 없음(결정 C). 로그인 화면·탭 제목·학원 공개 랜딩은 세션이 없어 지점을 모르므로
# "이 배포의 회사 브랜드" 학원 하나의 학원설정(로고·학원명)을 보여 준다.
# 학원이 1개면 자동(비워 둔다). 2개 이상이면 대표 지점의 tenants.slug를 적는다 — 안 적으면 제품 중립 표기로 떨어진다
# (첫 학원을 임의로 고르지 않는다). 지점 판정용이 아니다(자리 PIN은 화면에서 지점을 고른다). 지금 테넌트 = 침산(slug `cs`).
PUBLIC_BRAND_TENANT_SLUG=

# ── 오늘 수학 관리 동기화 v2 (선택, 서버 전용) ───────────────────────────────
# 양쪽 프로젝트에 동일한 binding 목록. 처음에는 DB binding을 shadow로 등록한다.
# 각 항목: bindingId, tenantId, targetBranchId, sourceBaseUrl, targetBaseUrl, keyId,
# controlSecret, webhookSecret, ssoSecret. 키마다 서로 다른 난수 32자 이상 사용.
# URL은 고정 HTTPS origin. NEXT_PUBLIC_ 접두어 금지. 실제 키를 이 파일에 넣지 않는다.
# docs/todays-math-sync-implementation-contract.md 및 운영 절차 참고.
EYWA_SYNC_BINDINGS_JSON=[]
# 원본 pg_net → 원본 dispatcher 즉시 깨우기. CRON_SECRET과 별도 키.
TODAYS_MATH_SYNC_WAKE_SECRET=
# 구글 캘린더 → aywa 임포트 크론이 붓는 학원(선택). 비면 학원이 정확히 1개일 때만 그 학원 · 둘 이상이면 **멈춘다**(남의 학원에
# 일정을 붓지 않는다). 둘째 지점을 만들기 전에 침산 id로 못박는다(docs/domain-cutover.md). 연동 PC의 CLASSNOTE_TENANT_ID·
# MAKEEDU_TENANT_ID도 같은 규칙.
GOOGLE_CALENDAR_TENANT_ID=

# ── 숙제 영상 Google 계정 (Vercel 전용) ──
# 이미 있는 OAuth 클라이언트가 웹 애플리케이션이면 그대로 쓴다.
# 데스크톱 앱이면 같은 프로젝트에 웹 애플리케이션을 하나 추가하고, 기존 데스크톱 클라이언트는 남긴다.
# 웹 클라이언트는 모든 지점이 하나다. 각 지점은 자기 Google 계정으로 로그인한다.
# 클라이언트 비밀은 서버에만 둔다. 발송 PC에 복사하지 않는다.
# 발송 PC의 GOOGLE_DRIVE_* 세 키는 연결 없는 기존 계정만 담당한다.
# REDIRECT_URI 는 콘솔에 등록한 고정 전체 주소다. 쿼리·해시 없음.
# 운영 예: https://www.aywa.co.kr/api/integrations/homework-video-drive/callback
HOMEWORK_VIDEO_GOOGLE_CLIENT_ID=
HOMEWORK_VIDEO_GOOGLE_CLIENT_SECRET=
HOMEWORK_VIDEO_GOOGLE_REDIRECT_URI=
# HOMEWORK_VIDEO_GOOGLE_PREVIOUS_CLIENT_ID=
# HOMEWORK_VIDEO_GOOGLE_PREVIOUS_CLIENT_SECRET=

# T맵 보행자 길찾기(SK오픈API · 하루 1,000건 무료) — 학부모·관리자 "가까운 노선 찾기". 비우면 카카오 도로 길로 어림
TMAP_APP_KEY=

# 학원 비서 — Terra low 전용(서버만 사용). 비어 있으면 OPENAI_API_KEY를 사용한다.
# Claude/DeepSeek 키로 대신 호출하지 않는다. 실제 값은 로컬 비밀 환경/Vercel 환경변수에 등록한다.
OPENAI_API_KEY_ASSISTANT=
