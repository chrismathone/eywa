# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — never expose to the client
SUPABASE_SERVICE_ROLE_KEY=

# Drizzle / direct Postgres connection (Project Settings → Database → Connection string → URI)
# Use the pooled URI for runtime (ends with :6543/postgres) and the direct URI for drizzle-kit migrations.
DATABASE_URL=postgresql://postgres:PASSWORD@HOST:6543/postgres?pgbouncer=true

# Anthropic — server-only for AI analysis
# ANTHROPIC_API_KEY: 기본 키 (등록상담/회의록 분석)
ANTHROPIC_API_KEY=
# ANTHROPIC_API_KEY_CONSULTATIONS: 학생 케어 인사이트 전용 (사용량 분리)
ANTHROPIC_API_KEY_CONSULTATIONS=

# AssemblyAI — 한국어 음성 전사 (회의록 + 등록상담)
ASSEMBLYAI_API_KEY=
# Webhook callback secret — POST /api/webhooks/assemblyai에서 x-eywa-webhook-secret 헤더로 검증
ASSEMBLYAI_WEBHOOK_SECRET=

# Gemini (선택) — fast-tier 작업용. 현재 코드에서는 미사용
GEMINI_API_KEY=
