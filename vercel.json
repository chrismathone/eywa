{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["icn1"],
  "ignoreCommand": "git rev-parse -q --verify HEAD^2 >/dev/null && exit 1 || git diff --quiet HEAD^ HEAD -- ':(exclude)docs' ':(exclude)scripts' ':(exclude).claude' ':(exclude)*.md'",
  "crons": [
    {
      "path": "/api/cron/apply-due-class-updates",
      "schedule": "30 15 * * *"
    },
    {
      "path": "/api/cron/recordings-retention",
      "schedule": "0 17 * * *"
    },
    {
      "path": "/api/cron/reconcile-transcriptions",
      "schedule": "0 18 * * *"
    },
    {
      "path": "/api/cron/sheets-sync",
      "schedule": "0 19 * * *"
    },
    {
      "path": "/api/cron/daily-briefing",
      "schedule": "0 22 * * *"
    }
  ]
}
