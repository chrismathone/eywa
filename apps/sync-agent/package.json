{
  "name": "eywa-sync-agent", "productName": "AYWA 연동", "version": "1.0.15", "private": true,
  "description": "AYWA 지점 통합 연동 앱", "author": "AYWA", "main": "main.cjs",
  "scripts": { "start": "electron .", "prepare:runtime": "node prepare.cjs", "test": "node --test test/*.test.cjs", "package": "electron-builder --win nsis --x64 --publish never" },
  "dependencies": { "yauzl": "3.4.0", "zod": "4.4.3" },
  "devDependencies": { "electron": "44.7.0", "electron-builder": "26.15.3", "esbuild": "0.28.2" },
  "build": {
    "appId": "kr.co.aywa.sync", "executableName": "AywaSyncRuntime", "asar": true,
    "afterPack": "after-pack.cjs",
    "directories": { "output": "dist" },
    "files": ["main.cjs", "preload.cjs", "ui/**", "lib/**", "build-config.json"],
    "extraResources": [{ "from": "build/runtime", "to": "runtime" }, { "from": "build/browsers", "to": "browsers" }, { "from": "build/ffmpeg", "to": "ffmpeg" }, { "from": "build/WorkerHost.exe", "to": "WorkerHost.exe" }],
    "extraFiles": [{ "from": "build/AywaSync.exe", "to": "AywaSync.exe" }],
    "win": { "target": "nsis", "artifactName": "AywaSync-Setup-${version}.exe", "icon": "build/icon.ico", "signExecutable": false },
    "nsis": { "oneClick": false, "perMachine": false, "allowToChangeInstallationDirectory": false, "createDesktopShortcut": false, "createStartMenuShortcut": false, "include": "installer.nsh", "runAfterFinish": false, "deleteAppDataOnUninstall": false }
  }
}
