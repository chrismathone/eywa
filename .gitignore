# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# dev scratch / 런타임 로그 (추적 안 함)
/work/
.claude/worktrees/

# env files (can opt-in for committing if needed)
.env*
!.env*.example
!.env.example

# 영상 보관 Drive OAuth — 비밀이 든 파일(값 파일 · 구글 클라이언트 JSON)
aywa-video-oauth*.txt
client_secret*.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# makeedu import drop zone (real PII files - never commit)
scripts/_makeedu/_incoming/
# makeedu scrape 출력·로그 (real PII - never commit) — 기본 출력 디렉터리(MAKEEDU_OUT 미설정 시)
/.makeedu-tmp/

# Edutrix 소등 아카이브 — 학생 PII 원본(35MB). 절대 커밋 금지, 로컬 보관 전용.
data/edutrix-archive/

# 발송 PC 워커 zip — 빌드 산출물(폴더의 README만 추적). 롤백용 옛 zip은 로컬에 남긴다.
data/발송PC-워커/*.zip
data/연동PC-makeedu/*.zip

# ijw-calander Firebase 삭제 전 마지막 백업(1.7GB, PII 포함) — 로컬 보관 전용
data/ijw-firebase-backup/

# drizzle-kit generate 생성물(2026-10-27 시즌2 — 필요한 문장만 s2_NNNN 파일로 옮겨 쓴다)
/supabase/drizzle-out/

# 로컬 게이트(scripts/verify-changed.mjs) 임시 tsconfig·결과 기록
/.verify/
