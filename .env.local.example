# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — never expose to the client
SUPABASE_SERVICE_ROLE_KEY=

# Drizzle / direct Postgres connection (Project Settings → Database → Connection string → URI)
# Use the pooled URI for runtime (ends with :6543/postgres) and the direct URI for drizzle-kit migrations.
DATABASE_URL=postgresql://postgres:PASSWORD@HOST:6543/postgres?pgbouncer=true

# AI provider — balanced 티어 기본 provider. 미설정 시 "upstage"(= Solar Pro 3, 한국어·저비용).
# "anthropic"으로 두면 즉시 Claude 롤백. reasoning 티어는 항상 Anthropic.
AI_PROVIDER=upstage

# Upstage Solar — server-only. OpenAI 호환(base URL https://api.upstage.ai/v1, 모델 solar-pro3).
# 발급: https://console.upstage.ai → API Keys. (AI_PROVIDER=upstage면 이 키가 기본 사용됨)
# UPSTAGE_API_KEY: 기본 키 (등록상담/회의록 분석)
UPSTAGE_API_KEY=
# UPSTAGE_API_KEY_CONSULTATIONS: 학생 케어 인사이트 전용 (없으면 UPSTAGE_API_KEY로 폴백)
UPSTAGE_API_KEY_CONSULTATIONS=

# Anthropic — server-only. AI_PROVIDER=anthropic이거나 Upstage 키가 없을 때 폴백, reasoning 티어 전용.
# ANTHROPIC_API_KEY: 기본 키 (등록상담/회의록 분석)
ANTHROPIC_API_KEY=
# ANTHROPIC_API_KEY_CONSULTATIONS: 학생 케어 인사이트 전용 (사용량 분리)
ANTHROPIC_API_KEY_CONSULTATIONS=

# AssemblyAI — 한국어 음성 전사 (회의록 + 등록상담)
ASSEMBLYAI_API_KEY=
# Webhook callback secret — POST /api/webhooks/assemblyai에서 x-eywa-webhook-secret 헤더로 검증
ASSEMBLYAI_WEBHOOK_SECRET=

# Gemini (선택) — fast-tier 작업용. 현재 코드에서는 미사용
GEMINI_API_KEY=

# Google Sheets 동기화 (선택) — service account JWT
# Google Cloud Console에서 service account 생성 후 JSON 키 다운로드 → 전체 JSON 또는 base64 인코딩 후 입력
# scopes: drive, spreadsheets
GOOGLE_SERVICE_ACCOUNT_KEY=

# ── 출석 키오스크 알림톡 (향후 실발송) ─────────────────────────────────────────
# 현재 데모는 '발송 시뮬레이션'(실제 전송 없음)이라 아래 키 없이 동작한다.
# 카카오 비즈채널 인증·발신프로필·템플릿 사전심사 완료 후 Solapi 중계사로 실발송 전환 시 사용.
# (per-tenant 발신키는 DB 암호화 저장이 정석 — 아래는 전역 폴백/개발용)
# SOLAPI_API_KEY=
# SOLAPI_API_SECRET=
# KAKAO_SENDER_KEY=
# 발송 결과 콜백 검증용 시크릿 — POST /api/webhooks/kakao 에서 사용(향후)
# KAKAO_WEBHOOK_SECRET=
