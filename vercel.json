{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["icn1"],
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- ':(exclude)docs' ':(exclude)scripts' ':(exclude).claude' ':(exclude)*.md'",
  "crons": [
    {
      "path": "/api/cron/reconcile-transcriptions",
      "schedule": "0 18 * * *"
    },
    {
      "path": "/api/cron/edutrix-sync",
      "schedule": "30 18 * * *"
    },
    {
      "path": "/api/cron/sheets-sync",
      "schedule": "0 19 * * *"
    },
    {
      "path": "/api/cron/daily-briefing",
      "schedule": "0 22 * * *"
    }
  ]
}
