{
  "name": "eywa_refactoring",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "vitest run src/features/students/server/past-class-teachers.test.ts src/features/students/lib/past-class-teacher.test.ts && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "node --max-old-space-size=6144 node_modules/typescript/bin/tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:assets": "vitest run tests/unit/empty-state-assets.test.ts",
    "test:e2e": "playwright test",
    "manual:shots": "node --env-file=.env.local scripts/_manual/capture.mjs",
    "manual:build": "node --env-file=.env.local scripts/_manual/build.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node -e \"console.error('db:migrate는 2026-10-27 SQL 시즌2부터 쓰지 않습니다 — 새(빈) DB 셋업은 pnpm db:alphas · 운영 DB에는 새 s2_NNNN 파일 하나만 원장 승인 뒤 적용'); process.exit(1)\"",
    "db:push": "node -e \"console.error('db:push는 쓰지 않습니다 — drizzle-kit push는 시즌1 SQL의 RLS·트리거·함수를 몰라 삭제를 제안할 수 있고, 운영 DB에 바로 씁니다. 운영 DB에는 새 s2_NNNN 파일 하나만 원장 승인 뒤 적용 · 새(빈) DB 셋업은 pnpm db:alphas'); process.exit(1)\"",
    "db:studio": "drizzle-kit studio",
    "db:alphas": "tsx scripts/apply-all-alphas.ts",
    "test:rls": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.98.0",
    "@base-ui/react": "^1.5.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@google-cloud/firestore": "^7.11.6",
    "@hookform/resolvers": "^5.4.0",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.106.2",
    "@tanstack/react-query": "^5.100.14",
    "@tiptap/extension-table": "^3.30.1",
    "@tiptap/extension-text-align": "^3.30.1",
    "@tiptap/extensions": "^3.30.1",
    "@tiptap/pm": "^3.30.1",
    "@tiptap/react": "^3.30.1",
    "@tiptap/starter-kit": "^3.30.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.3.0",
    "drizzle-orm": "^0.45.2",
    "exceljs": "^4.4.0",
    "googleapis": "^172.0.0",
    "html2canvas": "^1.4.1",
    "libpg-query": "^17.8.2",
    "next": "16.2.6",
    "next-themes": "^0.4.6",
    "openai": "^6.42.0",
    "postgres": "^3.4.9",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.76.1",
    "recharts": "^3.8.1",
    "sanitize-html": "^2.17.6",
    "shadcn": "^4.8.0",
    "solapi": "^6.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "unpdf": "^1.8.0",
    "web-push": "^3.6.7",
    "zod": "^4.4.3",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@shadcn/lint": "0.2.0",
    "@tailwindcss/postcss": "^4",
    "@tanstack/react-query-devtools": "^5.100.14",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.1",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "4.1.7",
    "@vitest/ui": "^4.1.7",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "happy-dom": "^20.9.0",
    "sharp": "0.34.5",
    "tailwindcss": "^4",
